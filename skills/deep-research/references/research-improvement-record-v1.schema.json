{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/schemas/research-improvement-record-v1.json",
  "title": "Research Improvement Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "playbook_id",
    "implementation_or_proof_ids",
    "baseline",
    "hypothesis",
    "expected_measures",
    "observed_measures",
    "outcome_classification",
    "evidence_refs",
    "prior_work_effects",
    "source_quality_implications",
    "improvement_proposals",
    "reviewer",
    "owner",
    "next_review_date",
    "promotion_status",
    "promotion_guard"
  ],
  "properties": {
    "schema_version": {"const": "research-improvement-record-v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "playbook_id": {"type": "string", "minLength": 1},
    "implementation_or_proof_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "baseline": {
      "type": "object",
      "required": ["description", "evidence_refs"],
      "properties": {
        "description": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "hypothesis": {"type": "string", "minLength": 20},
    "expected_measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["measure", "threshold"],
        "properties": {
          "measure": {"type": "string"},
          "threshold": {"type": "string"}
        }
      }
    },
    "observed_measures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["measure", "value", "evidence_refs"],
        "properties": {
          "measure": {"type": "string"},
          "value": {},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "outcome_classification": {
      "enum": ["confirmed", "mixed", "refuted", "context_limited", "not_yet_measurable"]
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "prior_work_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prior_work_id", "effect"],
        "properties": {
          "prior_work_id": {"type": "string", "pattern": "^PW-[0-9]{3,}$"},
          "effect": {"enum": ["confirmed", "extended", "superseded", "contradicted", "unchanged"]}
        }
      }
    },
    "source_quality_implications": {"type": "array", "items": {"type": "string"}},
    "improvement_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proposal_id", "destination", "change", "evidence_refs"],
        "properties": {
          "proposal_id": {"type": "string"},
          "destination": {"enum": ["skill", "template", "process", "export", "linear", "source_registry", "no_change"]},
          "change": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "no_change_reason": {"type": ["string", "null"]}
        }
      }
    },
    "reviewer": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "next_review_date": {"type": "string", "format": "date"},
    "promotion_status": {"enum": ["proposed", "approved", "rejected", "no_change"]},
    "promotion_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_evidence_present", "independent_review_passed", "automatic_mutation_allowed"],
      "properties": {
        "observed_evidence_present": {"type": "boolean"},
        "independent_review_passed": {"type": "boolean"},
        "automatic_mutation_allowed": {"const": false}
      }
    }
  }
}
