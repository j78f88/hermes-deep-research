{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research.local/schemas/implementation-operating-playbook-v1.json",
  "title": "Implementation or Operating Playbook v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "playbook_id", "target_form", "input_bundle_sha256", "prior_work_context_sha256", "target_outcome", "definition_of_done", "strategy", "stages", "controls", "tests", "operations", "risks", "improvement_experiment", "owner_gates", "status", "promotion_guard"],
  "properties": {
    "schema_version": {"const": "implementation-or-operating-playbook-v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "playbook_id": {"type": "string", "minLength": 1},
    "target_form": {"enum": ["software_integration", "procurement_adoption", "business_process_sop", "system_architecture", "venture_validation", "policy_governance", "experiment_reproducibility", "source_system_workflow"]},
    "input_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prior_work_context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_outcome": {"type": "string", "minLength": 20},
    "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "strategy": {"enum": ["reuse", "extend", "replace", "build", "buy", "borrow", "partner", "hybrid", "do_not_proceed"]},
    "strategy_reason": {"type": "string", "minLength": 1},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "name", "outcome", "claim_ids", "prior_work_ids", "owners", "dependencies", "acceptance", "rollback", "activation_authorized"],
        "properties": {
          "stage_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "minLength": 1},
          "material": {"type": "boolean"},
          "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"}},
          "prior_work_ids": {"type": "array", "items": {"type": "string", "pattern": "^PW-[0-9]{3,}$"}},
          "novelty_or_duplicate_verdict": {"enum": ["reuse", "extension", "new", "duplicate_do_not_build", "replacement"]},
          "owners": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "affected_systems_or_files": {"type": "array", "items": {"type": "string"}},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rollback": {"type": "string", "minLength": 1},
          "owner_gate": {"type": ["string", "null"]},
          "activation_authorized": {"const": false}
        }
      }
    },
    "controls": {"type": "array", "items": {"type": "string"}},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "operations": {"type": "object", "required": ["runbook", "monitoring", "support_owner", "maintenance_burden"], "properties": {"runbook": {"type": "array", "items": {"type": "string"}}, "monitoring": {"type": "array", "items": {"type": "string"}}, "support_owner": {"type": "string"}, "maintenance_burden": {"type": "string"}}},
    "risks": {"type": "array", "items": {"type": "object", "required": ["risk", "mitigation", "recovery"], "properties": {"risk": {"type": "string"}, "mitigation": {"type": "string"}, "recovery": {"type": "string"}}}},
    "improvement_experiment": {"type": "object", "required": ["baseline", "hypothesis", "measures", "thresholds", "review_trigger"], "properties": {"baseline": {"type": "string"}, "hypothesis": {"type": "string"}, "measures": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "thresholds": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "review_trigger": {"type": "string"}}},
    "owner_gates": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["PASS", "HOLD", "FAIL"]},
    "promotion_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_observed_evidence", "requires_independent_review", "automatic_mutation_allowed"],
      "properties": {
        "requires_observed_evidence": {"const": true},
        "requires_independent_review": {"const": true},
        "automatic_mutation_allowed": {"const": false}
      }
    }
  }
}
